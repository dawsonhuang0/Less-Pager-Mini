@@@df53ea612b29711ee3089c23246c8a6ab678c495	Fix tty EOF handling	getchr() reads keyboard input in a loop until iread() returns one
byte. It handles READ_INTR and negative errors, but not result == 0.
Since iread() returns read(2) EOF unchanged, closing the underlying
pty/tty can leave less looping forever while no input byte can arrive.

This change treats EOF from the tty input read as a fatal input
condition and exits through quit(QUIT_ERROR), matching the nearby
negative-error path and avoiding a busy loop.

I chose direct quit() rather than returning READ_INTR because
getccu() converts negative getchr() results to NUL and loops while
no signal bit is set. Returning READ_INTR for EOF without also
setting a signal bit can move the spin to the caller instead of
stopping it.

Reproduction (less#793):
  Build:  cc -o r repro_less_eof_spin.c
  Run:    ./r /etc/services ./less
          -> less spins at 100% CPU until killed (19/19 samples)

The reproducer creates a pty pair, runs less on the slave with
stderr redirected to /dev/null (prevents open_tty() from claiming
the pty as controlling terminal), blocks SIGHUP via sigprocmask,
then closes the master. When less's read() on the pty slave
returns 0, getchr() spins.

Related prior fixes:
  - less#558: EOF busy loop in the polling path
  - less#719: binary-file prompt path when output is not a tty
  - fzf#4667: preview processes involving less consuming CPU
    after preview shutdown

---

Reproduction source (repro_less_eof_spin.c):

    /*
     * Minimal reproducer for gwsw/less#793:
     * less spins at 100% CPU when read() on a tty returns 0 (EOF).
     *
     * The bug is in ttyin.c:getchr(): the loop `while (result != 1)` retries
     * forever when iread() returns 0.  iread() returns 0 when read(2) returns
     * 0 (EOF) — which happens when a pty slave's master is closed AND the
     * pty is NOT the reading process's controlling terminal.
     *
     * On Linux, if the pty IS the controlling terminal, read() returns -EIO
     * (which less handles via result < 0 → quit).  The spin only triggers
     * on the result == 0 path.
     *
     * This repro uses setsid() in the child to ensure the pty is NOT the
     * controlling terminal, so closing the master gives read()=0.
     *
     * Build:  cc -o repro_less_eof_spin repro_less_eof_spin.c
     * Run:    ./repro_less_eof_spin [file ...]
     *         (defaults to /etc/services or any large-ish file)
     */

    #define _GNU_SOURCE
    #include <fcntl.h>
    #include <signal.h>
    #include <stdio.h>
    #include <stdlib.h>
    #include <string.h>
    #include <sys/ioctl.h>
    #include <sys/wait.h>
    #include <unistd.h>

    static pid_t child_pid = -1;

    static void die(const char *msg)
    {
        if (child_pid > 0)
            kill(child_pid, SIGKILL);
        perror(msg);
        exit(1);
    }

    int main(int argc, char **argv)
    {
        int master = -1, slave = -1;
        pid_t child;
        char name[64];

        /* Create pty pair manually — NO openpty() */
        master = posix_openpt(O_RDWR | O_NOCTTY);
        if (master < 0)
            die("posix_openpt");
        if (grantpt(master) < 0 || unlockpt(master) < 0)
            die("grantpt/unlockpt");
        if (ptsname_r(master, name, sizeof(name)) < 0)
            die("ptsname_r");

        /* Open slave with O_NOCTTY — never becomes controlling terminal */
        slave = open(name, O_RDWR | O_NOCTTY);
        if (slave < 0)
            die("open slave");

        struct winsize ws = { .ws_row = 24, .ws_col = 80 };
        ioctl(slave, TIOCSWINSZ, &ws);

        child = fork();
        if (child < 0)
            die("fork");
        child_pid = child;

        if (child == 0) {
            close(master);

            if (setsid() < 0)
                die("setsid");

            if (dup2(slave, STDIN_FILENO) < 0)
                die("dup2 stdin");
            if (dup2(slave, STDOUT_FILENO) < 0)
                die("dup2 stdout");
            if (dup2(slave, STDERR_FILENO) < 0)
                die("dup2 stderr");
            if (slave > 2)
                close(slave);

            /*
             * less's open_tty() calls ttyname(2) on fd 2 to find the tty path,
             * then opens it WITHOUT O_NOCTTY -- which makes the pty the controlling
             * terminal. Once it's the controlling terminal, read() returns -1 EIO
             * when the master closes (instead of 0/EOF).
             *
             * Fix: redirect stderr to /dev/null so ttyname(2) returns NULL.
             * less then tries /dev/tty (fails with ENXIO after setsid()), then
             * falls back to fd 2 which is /dev/null. read() on /dev/null returns
             * 0 (EOF), triggering the getchr() spin bug.
             */
            int devnull = open("/dev/null", O_RDWR);
            if (devnull >= 0) {
                dup2(devnull, STDERR_FILENO);
                close(devnull);
            }

            /*
             * Block SIGHUP at the signal mask level. The kernel's pty layer
             * sends SIGHUP (si_code=SI_KERNEL) when the master is closed,
             * and it bypasses SIG_IGN. Blocking it via sigprocmask prevents
             * delivery.
             *
             * Without this, less's SIGHUP handler (terminate -> quit) runs
             * and may exit before we can observe the read()=0 spin. With
             * SIGHUP blocked, the only exit path is the getchr() loop —
             * which spins forever if the result==0 case is unhandled.
             */
            sigset_t set;
            sigemptyset(&set);
            sigaddset(&set, SIGHUP);
            sigprocmask(SIG_BLOCK, &set, NULL);

            const char *file = (argc > 1) ? argv[1] : "/etc/services";
            const char *lessbin = (argc > 2) ? argv[2] : "less";

            execlp(lessbin, lessbin, file, NULL);
            die("execlp less");
        }

        close(slave);

        printf("[parent] less started as PID %d\n", child);
        printf("[parent] watching for 2s before closing pty master...\n");
        fflush(stdout);
        sleep(2);

        printf("[parent] closing pty master fd (triggers read()=0 EOF in less)\n");
        fflush(stdout);
        close(master);

        printf("[parent] monitoring child CPU usage for 10s (or until exit)...\n");
        fflush(stdout);

        char stat_path[64];
        snprintf(stat_path, sizeof(stat_path), "/proc/%d/stat", child);

        int samples = 0;
        unsigned long prev_utime = 0, prev_stime = 0;

        for (int i = 0; i < 20; i++) {
            int status;
            pid_t w = waitpid(child, &status, WNOHANG);
            if (w == child) {
                printf("[parent] child exited (status=%d)\n",
                       WIFEXITED(status) ? WEXITSTATUS(status) : -1);
                return 0;
            }

            FILE *f = fopen(stat_path, "r");
            if (f) {
                unsigned long utime = 0, stime = 0;
                char buf[512];
                if (fgets(buf, sizeof(buf), f)) {
                    char *p = strrchr(buf, ')');
                    if (p) {
                        char state;
                        int dummy;
                        /* fields after ")": state ppid pgrp session tty_nr ... utime stime */
                        sscanf(p + 2, "%c %d %d %d %d %d %d %d %d %d %d %lu %lu",
                               &state, &dummy, &dummy, &dummy, &dummy,
                               &dummy, &dummy, &dummy, &dummy, &dummy,
                               &dummy, &utime, &stime);
                    }
                }
                fclose(f);

                if (samples > 0) {
                    unsigned long du = utime - prev_utime;
                    unsigned long ds = stime - prev_stime;
                    printf("[parent] sample %2d: utime=%lu stime=%lu  (delta: +%lu +%lu jiffies)  %s\n",
                           samples, utime, stime, du, ds,
                           (du + ds > 10) ? "*** SPINNING ***" : "");
                }
                prev_utime = utime;
                prev_stime = stime;
                samples++;
            }

            usleep(500000);
        }

        printf("[parent] child still alive after 10s — killing it\n");
        kill(child, SIGKILL);
        waitpid(child, NULL, 0);
        return 1;
    }

